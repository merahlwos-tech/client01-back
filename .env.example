# ══════════════════════════════════════════════════════════════
# EXEMPLE de configuration — copier vers .env et remplir les vraies
# valeurs. NE JAMAIS committer le vrai .env (il est dans .gitignore).
# ══════════════════════════════════════════════════════════════

# Serveur
PORT=5000

# Base de données MongoDB
MONGO_URI=mongodb+srv://user:password@cluster.mongodb.net/dbname

# Auth JWT + compte propriétaire (agit comme superadmin de secours)
JWT_SECRET=changez-moi-par-une-longue-chaine-aleatoire
ADMIN_USERNAME=admin
ADMIN_PASSWORD=changez-moi

# Cloudinary (upload images / logos)
CLOUDINARY_CLOUD_NAME=xxxx
CLOUDINARY_API_KEY=xxxx
CLOUDINARY_API_SECRET=xxxx

# Cloudflare R2 (upload images produit)
R2_ENDPOINT=https://xxxx.r2.cloudflarestorage.com
R2_ACCESS_KEY_ID=xxxx
R2_SECRET_ACCESS_KEY=xxxx
R2_BUCKET_NAME=xxxx
R2_PUBLIC_URL=https://xxxx.r2.dev

# Meta / Facebook CAPI (tracking conversions)
META_PIXEL_ID=xxxx
META_ACCESS_TOKEN=xxxx

# Ecotrack (livraison — utilisé par le chef de production)
ECOTRACK_BASE_URL=https://ecotrack.dz
ECOTRACK_API_TOKEN=xxxx
